# ====================================
# MICROSOFT ENTRA APP CONFIGURATION
# ====================================
VITE_AZURE_TENANT_ID=your_tenant_id
VITE_AZURE_CLIENT_ID=your_client_id
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/[YOUR_TENANT_ID]/v2.0

# Your custom scope for token generation and verifications
VITE_AZURE_SCOPE=api://[YOUR_CLIENT_ID]/[your_custom_scope_name]

# ====================================
# FRONTEND & BACKEND CONFIGURATION
# ====================================
# Frontend URL (must match Redirect URI in App Registration)
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Backend API URL
VITE_API_URL=http://localhost:8080