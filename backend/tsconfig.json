{
    "compilerOptions": {
        "outDir": "./dist",
        // "rootDir": "./src",
        "lib": ["ESNext"],
        "target": "ESNext",
        "moduleResolution": "Node",
        "module": "CommonJS",
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
        
    },
    "include": ["src/**/*.ts"]
}